# Entorno (development, production, test)
NODE_ENV=development

# Servidor
PORT=8082
API_URL=http://localhost:8082

# Base de datos (PostgreSQL)
HOST=localhost
PORT_DB=5432
USER_DB=postgres
DB_PASSWORD=tu_contrasena_segura
DB_NAME=rutago_db

# SSL de PostgreSQL. ACTIVADO por defecto (lo exigen Neon, AWS RDS, Supabase...).
# En una base local declarada en HOST=localhost pon DB_SSL=false.
# DB_SSL=false

# CORS (múltiples orígenes separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8082
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=cambia_esto_por_una_clave_segura
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Opcional: base MySQL previa para migrar datos históricos (scripts/migrate-mysql-to-pg.js)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=usuario_mysql
# MYSQL_PASSWORD=clave_mysql
# MYSQL_DB=nombre_bd_mysql
