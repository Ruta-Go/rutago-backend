# Entorno (development, production, test)
NODE_ENV=development

# Servidor
PORT=8082
API_URL=http://localhost:8082

# Base de datos (PostgreSQL)
HOST=localhost
PORT_DB=5432
USER_DB=postgres
DB_PASSWORD=tu_contrasena_segura
DB_NAME=rutago_db

# SSL de PostgreSQL. Se decide SOLO segun HOST:
#   HOST local (localhost/127.0.0.1/::1) -> sin SSL
#   cualquier otro HOST (Neon, RDS...)   -> con SSL
# No hace falta configurar nada. DB_SSL=true|false solo se usa como
# override para casos especiales (p. ej. un Postgres local con SSL).
# DB_SSL=false

# CORS (múltiples orígenes separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:8082
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=cambia_esto_por_una_clave_segura
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Recuperación de contraseña (opcional en desarrollo, obligatorio en producción)
# Si EMAIL_API_KEY no está definida, en desarrollo el enlace se imprime en la
# consola del servidor; en producción el endpoint responde 503.
# EMAIL_API_KEY=tu_api_key_de_resend
# EMAIL_FROM=RutaGo <no-responder@tu-dominio.com>
# PASSWORD_RESET_URL=http://localhost:5173/recuperar-password

# Opcional: base MySQL previa para migrar datos históricos (scripts/migrate-mysql-to-pg.js)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=usuario_mysql
# MYSQL_PASSWORD=clave_mysql
# MYSQL_DB=nombre_bd_mysql
